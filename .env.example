# ──────────────────────────────────────────────────────────────
# CA Inter MCQ Pipeline — .env.example
# Copy to .env and fill real values. .env is gitignored.
# ──────────────────────────────────────────────────────────────

# ---------- AI Provider ----------
# Options: openai | anthropic | gemini | mock (for local tests)
AI_PROVIDER=openai

# OpenAI (primary)
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------- Google Drive Source (Mandatory for ingest) ----------
# Path to service-account.json (gitignored). Create folder content-pipeline/secrets/
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Drive Folder IDs (share folders with service-account email as Viewer)
# You can get ID from Drive URL: https://drive.google.com/drive/folders/<ID>
DRIVE_FOLDER_MODULES=1AbC...ModulesFolderId
DRIVE_FOLDER_RTP=
DRIVE_FOLDER_MTP=
DRIVE_FOLDER_PYQ=

# ---------- Storage / DB ----------
# For local review queue without real MongoDB, use memory://
MONGO_URL=memory://
# MONGO_URL=mongodb://localhost:27017
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/db

DB_NAME=ujjwal_pathak
MEMORY_DB_FILE=state/dev-db.json

# Where student frontend/backend repo is (for catalog authority check)
STUDENT_REPO_PATH=

# ---------- Pipeline Paths (optional overrides) ----------
PIPELINE_CACHE_DIR=.cache/drive
PIPELINE_STATE_DIR=state
PIPELINE_DIST_DIR=dist
CATALOG_SNAPSHOT_PATH=config/chapters.json
EXPECTED_CHAPTER_COUNT=94

# ---------- Generation Tuning ----------
QUESTIONS_PLAIN_PER_CHAPTER=30
SCENARIOS_PER_CHAPTER=5
QUESTIONS_PER_SCENARIO=4
GENERATION_PARALLELISM=2
GENERATION_MAX_RETRIES=3

# ---------- Similarity Gates ----------
SIMILARITY_FLAG=0.75
SIMILARITY_BLOCK=0.9

# ---------- Publishing ----------
PUBLIC_CONTENT_BASE_URL=http://localhost:8000/api/content/student

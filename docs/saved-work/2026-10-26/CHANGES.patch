+async def run_provider(sid, kind, action):
+    if not os.environ.get('GROQ_API_KEY','').strip():
+        raise HTTPException(503, 'AI is not configured. Keep your draft and retry later.')
+    try:
+        await asyncio.wait_for(_SLOTS.acquire(), 0.2)

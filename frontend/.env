# FIX: Prevent "Expected JSON but received HTML" error
# same-origin makes CRA dev server proxy /api -> http://localhost:8010
# This works both locally and in cloud previews (Codespaces, E2B, Gitpod)
# where browser cannot directly reach localhost:8010
REACT_APP_MENTOR_API_URL=same-origin
MENTOR_API_PROXY_TARGET=http://localhost:8010
PORT=3000
HOST=0.0.0.0
DANGEROUSLY_DISABLE_HOST_CHECK=true
# For E2B / cloud preview, ensure WDS socket works
WDS_SOCKET_HOST=0.0.0.0
WDS_SOCKET_PORT=0

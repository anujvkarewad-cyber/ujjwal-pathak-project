# Safe UI development (default): sample data only, no backend requests.
EXPO_PUBLIC_USE_MOCKS=true

# For a connected APK, set false. This URL is the existing frontend deployment;
# the app automatically appends /api/proxy and does not modify the backend.
EXPO_PUBLIC_API_BASE_URL=https://student-dashboard-frontend-iota.vercel.app

# Mentor-reviewed/published MCQ bank (FastAPI, not the Apps Script proxy).
EXPO_PUBLIC_MENTOR_API_URL=https://ujjwal-pathak-project.onrender.com

# Optional: shared secret used to compute the /api/progress-sync HMAC token.
# Set to the SAME value as the mentor backend's SYNC_SECRET. Leave blank when
# the backend has no SYNC_SECRET configured (dev mode accepts any token).
EXPO_PUBLIC_MENTOR_SYNC_SECRET=

# App version reported by the mentor analytics consent payload.
EXPO_PUBLIC_APP_VERSION=1.10.2

+const PASSWORD_RECOVERY_ROUTES = {
+  forgotPassword: "/api/student-auth/forgot-password",
+  verifyOTP: "/api/student-auth/verify-otp",
+  resetPassword: "/api/student-auth/reset-password"
+};
+
+async function servePasswordRecovery(req, res, action) {
+  const route = PASSWORD_RECOVERY_ROUTES[action];
+  if (!MENTOR_API_URL || !route) {
+    return res.status(503).json({
+      error: "Account recovery is not available right now. Please try again in a minute."
+    });
+  }
+  const payload = (req.body && req.body.payload) || {};
+  const forwardBody = {
+    studentId: String(payload.studentId || req.body?.studentId || "").trim()
+  };
+  if (action === "forgotPassword") {
+    forwardBody.email = String(payload.email || req.body?.email || "").trim();
+  } else if (action === "verifyOTP") {
+    forwardBody.otp = String(payload.otp || req.body?.otp || "").trim();
+  } else if (action === "resetPassword") {
+    forwardBody.password = String(
+      payload.password || payload.newPassword || req.body?.password || req.body?.newPassword || ""
+    );
+  }
+
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 35000);
+  try {
+    const upstream = await fetch(`${MENTOR_API_URL}${route}`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(forwardBody),
+      signal: controller.signal
+    });
+    const data = await upstream.json().catch(() => null);
+    if (!upstream.ok) {
+      const detail =
+        (data && typeof data.detail === "string" && data.detail) ||
+        (data && typeof data.error === "string" && data.error) ||
+        "Account recovery is temporarily unavailable. Please try again in a minute.";
+      return res.status(upstream.status >= 500 ? upstream.status : 502).json({ error: detail });
+    }
+    const result = data && typeof data.result === "object" && data.result !== null ? data.result : null;
+    if (!result || typeof result.success !== "boolean") {
+      return res.status(502).json({
+        error: "Account recovery returned an unexpected response. Please try again."
+      });
+    }
+    return res.status(200).json({ result });
+  } catch (err) {
+    console.error("Password recovery forward failed:", action, err && err.message);
+    return res.status(502).json({
+      error: "Could not reach the account recovery service. Please try again in a moment."
+    });
+  } finally {
+    clearTimeout(timer);
+  }
+}

diff --git a/test/proxy-password-recovery.test.mjs b/test/proxy-password-recovery.test.mjs
new file mode 100644
index 0000000..c1d6b37
--- /dev/null
+++ b/test/proxy-password-recovery.test.mjs
@@ -0,0 +1,158 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+process.env.MENTOR_API_URL = "https://mentor.example.test";
+process.env.APPS_SCRIPT_URL = "https://proof-only-script.must-not-run.invalid/exec";
+const { default: handler } = await import("../api/proxy.js");
+
+const makeReq = (action, payload) => ({
+  method: "POST",
+  headers: {},
+  body: { action, payload },
+  query: {},
+});
+
+const makeRes = () => ({
+  statusCode: 200,
+  body: undefined,
+  headers: {},
+  status(code) {
+    this.statusCode = code;
+    return this;
+  },
+  setHeader(name, value) {
+    this.headers[name.toLowerCase()] = value;
+    return this;
+  },
+  json(body) {
+    this.body = body;
+    return this;
+  },
+});
+
+const withFetch = async (implementation, fn) => {
+  const original = globalThis.fetch;
+  globalThis.fetch = implementation;
+  try {
+    await fn();
+  } finally {
+    globalThis.fetch = original;
+  }
+};
+
+test("forgotPassword, verifyOTP and resetPassword route to MENTOR_API_URL and never call APPS_SCRIPT_URL", async () => {
+  const calls = [];
+  await withFetch(async (url, init) => {
+    assert.ok(
+      !String(url).includes("proof-only-script"),
+      `Recovery must never hit APPS_SCRIPT_URL, got ${url}`
+    );
+    calls.push({ url, method: init.method, body: JSON.parse(init.body) });
+    if (url.endsWith("/api/student-auth/forgot-password")) {
+      return Response.json({
+        result: {
+          success: true,
+          message: "A verification code has been sent to iq***5@gmail.com.",
+        },
+      });
+    }
+    if (url.endsWith("/api/student-auth/verify-otp")) {
+      return Response.json({
+        result: {
+          success: true,
+          message: "Code verified. You can now set a new password.",
+        },
+      });
+    }
+    if (url.endsWith("/api/student-auth/reset-password")) {
+      return Response.json({
+        result: {
+          success: true,
+          message: "Password reset successful. Sign in with your new password.",
+        },
+      });
+    }
+    throw new Error(`Unexpected URL: ${url}`);
+  }, async () => {
+    const fpRes = makeRes();
+    await handler(
+      makeReq("forgotPassword", { studentId: "UMP10000", email: "iqrasayyed135@gmail.com" }),
+      fpRes
+    );
+    assert.equal(fpRes.statusCode, 200);
+    assert.deepEqual(fpRes.body, {
+      result: {
+        success: true,
+        message: "A verification code has been sent to iq***5@gmail.com.",
+      },
+    });
+
+    const otpRes = makeRes();
+    await handler(
+      makeReq("verifyOTP", { studentId: "UMP10000", otp: "482910" }),
+      otpRes
+    );
+    assert.equal(otpRes.statusCode, 200);
+    assert.equal(otpRes.body.result.success, true);
+
+    const rpRes = makeRes();
+    await handler(
+      makeReq("resetPassword", { studentId: "UMP10000", password: "NewStrongPass#2027" }),
+      rpRes
+    );
+    assert.equal(rpRes.statusCode, 200);
+    assert.equal(rpRes.body.result.success, true);
+  });
+
+  assert.deepEqual(calls, [
+    {
+      url: "https://mentor.example.test/api/student-auth/forgot-password",
+      method: "POST",
+      body: { studentId: "UMP10000", email: "iqrasayyed135@gmail.com" },
+    },
+    {
+      url: "https://mentor.example.test/api/student-auth/verify-otp",
+      method: "POST",
+      body: { studentId: "UMP10000", otp: "482910" },
+    },
+    {
+      url: "https://mentor.example.test/api/student-auth/reset-password",
+      method: "POST",
+      body: { studentId: "UMP10000", password: "NewStrongPass#2027" },
+    },
+  ]);
+});
+
+test("recovery preserves backend success:false rejections without falling back to APPS_SCRIPT_URL", async () => {
+  await withFetch(async (url) => {
+    assert.equal(url, "https://mentor.example.test/api/student-auth/verify-otp");
+    return Response.json({
+      result: { success: false, message: "Incorrect verification code. 4 attempts left." },
+    });
+  }, async () => {
+    const res = makeRes();
+    await handler(makeReq("verifyOTP", { studentId: "UMP10000", otp: "000000" }), res);
+    assert.equal(res.statusCode, 200);
+    assert.deepEqual(res.body, {
+      result: { success: false, message: "Incorrect verification code. 4 attempts left." },
+    });
+  });
+});
+
+test("recovery upstream outage returns 502 and never falls back to APPS_SCRIPT_URL", async () => {
+  let calls = 0;
+  await withFetch(async (url) => {
+    calls += 1;
+    assert.equal(url, "https://mentor.example.test/api/student-auth/forgot-password");
+    return Response.json({ detail: "Account recovery is temporarily unavailable." }, { status: 502 });
+  }, async () => {
+    const res = makeRes();
+    await handler(
+      makeReq("forgotPassword", { studentId: "UMP10000", email: "iqrasayyed135@gmail.com" }),
+      res
+    );
+    assert.equal(res.statusCode, 502);
+    assert.equal(res.body.error, "Account recovery is temporarily unavailable.");
+    assert.equal(calls, 1);
+  });
+});
diff --git a/test/solved-questions-study-log.test.mjs b/test/solved-questions-study-log.test.mjs
new file mode 100644
index 0000000..5eb8c48
--- /dev/null
+++ b/test/solved-questions-study-log.test.mjs
@@ -0,0 +1,127 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import vm from "node:vm";
+import { fileURLToPath } from "node:url";
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const root = path.resolve(__dirname, "..");
+
+test("index.html separates DT and GST in Daily Study Log and includes solved-questions section", () => {
+  const html = fs.readFileSync(path.join(root, "index.html"), "utf8");
+  const subjectBlock = html.match(/id="tl-subjects-group"[\s\S]*?<\/div>/)?.[0] || "";
+  assert.ok(subjectBlock.includes('value="DT"'), "Expected DT checkbox in #tl-subjects-group");
+  assert.ok(subjectBlock.includes('value="GST"'), "Expected GST checkbox in #tl-subjects-group");
+  assert.ok(!subjectBlock.includes('value="Taxation"'), "Taxation must be split into DT and GST");
+  assert.ok(html.includes('id="tl-solved-section"'), "Expected #tl-solved-section in modal");
+  assert.ok(html.includes('id="tl-solved-rows"'), "Expected #tl-solved-rows in modal");
+});
+
+test("api.addStudyLog forwards structured solvedQuestions and uploads per-subject sheetFile", async () => {
+  const apiSource = fs.readFileSync(path.join(root, "api.js"), "utf8");
+  const calls = [];
+  const storage = new Map([
+    ["ump_student", JSON.stringify({ studentId: "UMP1001", password: "Pass@1001" })],
+  ]);
+  const sandbox = {
+    window: { location: { origin: "https://student.example.test" }, addEventListener() {} },
+    Date,
+    AbortSignal,
+    Response,
+    localStorage: {
+      getItem: (k) => (storage.has(k) ? storage.get(k) : null),
+      setItem: (k, v) => storage.set(k, String(v)),
+      removeItem: (k) => storage.delete(k),
+    },
+    sessionStorage: {
+      getItem: (k) => (storage.has(k) ? storage.get(k) : null),
+      setItem: (k, v) => storage.set(k, String(v)),
+      removeItem: (k) => storage.delete(k),
+    },
+    atob: (b64) => Buffer.from(b64, "base64").toString("binary"),
+    Uint8Array,
+    Blob,
+    URL,
+    Error,
+    Object,
+    Array,
+    String,
+    Number,
+    Boolean,
+    JSON,
+    Promise,
+    setTimeout,
+    clearTimeout,
+    AbortController,
+    fetch: async (url, init = {}) => {
+      calls.push({ url, init });
+      if (url === "/api/proof-capabilities") {
+        return {
+          ok: true,
+          status: 200,
+          json: async () => ({ protocol: "private-v1", private: true, maxBytes: 10485760 }),
+        };
+      }
+      if (url === "/api/proof-upload") {
+        const idx = calls.filter((c) => c.url === "/api/proof-upload").length;
+        return {
+          ok: true,
+          status: 200,
+          json: async () => ({
+            success: true,
+            fileId: `file_${idx}`,
+            proofUrl: `/api/proof-file?fileId=file_${idx}`,
+          }),
+        };
+      }
+      if (url === "/api/proxy") {
+        return {
+          ok: true,
+          status: 200,
+          text: async () => JSON.stringify({ result: { success: true, totalSolved: 22 } }),
+          json: async () => ({ result: { success: true, totalSolved: 22 } }),
+        };
+      }
+      throw new Error(`Unexpected fetch URL: ${url}`);
+    },
+  };
+  sandbox.window.UMP_API = null;
+  vm.createContext(sandbox);
+  vm.runInContext(apiSource, sandbox);
+
+  const samplePdfBase64 = Buffer.from("%PDF-1.4 test sheet").toString("base64");
+  const res = await sandbox.window.UMP_API.addStudyLog("UMP1001", {
+    date: "2026-11-28",
+    hours: 5,
+    studiedAsPlanned: "Yes",
+    subjects: "DT, GST",
+    targetCompleted: "Yes",
+    solvedQuestions: [
+      {
+        subject: "DT",
+        count: 14,
+        sheetName: "PGBP Sheet 2",
+        sheetFile: { fileName: "dt.pdf", mimeType: "application/pdf", base64: samplePdfBase64 },
+      },
+      {
+        subject: "GST",
+        count: 8,
+        sheetName: "ITC Sheet 1",
+      },
+    ],
+  });
+
+  assert.equal(res.success, true);
+  const proxyCall = calls.find((c) => c.url === "/api/proxy");
+  assert.ok(proxyCall, "Expected /api/proxy call");
+  const sent = JSON.parse(proxyCall.init.body);
+  assert.equal(sent.action, "addStudyLog");
+  assert.equal(sent.payload.solvedQuestions.length, 2);
+  assert.equal(sent.payload.solvedQuestions[0].subject, "DT");
+  assert.equal(sent.payload.solvedQuestions[0].count, 14);
+  assert.equal(sent.payload.solvedQuestions[0].proofUrl, "/api/proof-file?fileId=file_1");
+  assert.equal(sent.payload.solvedQuestions[0].sheetFile, undefined);
+  assert.equal(sent.payload.solvedQuestions[1].subject, "GST");
+  assert.equal(sent.payload.solvedQuestions[1].count, 8);
+});

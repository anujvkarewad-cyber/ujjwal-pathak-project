+++ b/test/proxy-password-recovery.test.mjs
@@ -0,0 +1,158 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+process.env.MENTOR_API_URL = "https://mentor.example.test";
+process.env.APPS_SCRIPT_URL = "https://proof-only-script.must-not-run.invalid/exec";
+const { default: handler } = await import("../api/proxy.js");
+
+const makeReq = (action, payload) => ({
+  method: "POST",
+  headers: {},
+  body: { action, payload },
+  query: {},
+});
+
+const makeRes = () => ({
+  statusCode: 200,
+  body: undefined,
+  headers: {},
+  status(code) {
+    this.statusCode = code;
+    return this;
+  },
+  setHeader(name, value) {
+    this.headers[name.toLowerCase()] = value;
+    return this;
+  },
+  json(body) {
+    this.body = body;
+    return this;
+  },
+});
+
+const withFetch = async (implementation, fn) => {
+  const original = globalThis.fetch;
+  globalThis.fetch = implementation;
+  try {
+    await fn();
+  } finally {
+    globalThis.fetch = original;
+  }
+};
+
+test("forgotPassword, verifyOTP and resetPassword route to MENTOR_API_URL and never call APPS_SCRIPT_URL", async () => {
+  const calls = [];
+  await withFetch(async (url, init) => {
+    assert.ok(
+      !String(url).includes("proof-only-script"),
+      `Recovery must never hit APPS_SCRIPT_URL, got ${url}`
+    );
+    calls.push({ url, method: init.method, body: JSON.parse(init.body) });
+    if (url.endsWith("/api/student-auth/forgot-password")) {
+      return Response.json({
+        result: {
+          success: true,
+          message: "A verification code has been sent to iq***5@gmail.com.",
+        },
+      });
+    }
+    if (url.endsWith("/api/student-auth/verify-otp")) {
+      return Response.json({
+        result: {
+          success: true,
+          message: "Code verified. You can now set a new password.",
+        },
+      });
+    }
+    if (url.endsWith("/api/student-auth/reset-password")) {
+      return Response.json({
+        result: {
+          success: true,
+          message: "Password reset successful. Sign in with your new password.",
+        },
+      });
+    }
+    throw new Error(`Unexpected URL: ${url}`);
+  }, async () => {
+    const fpRes = makeRes();
+    await handler(
+      makeReq("forgotPassword", { studentId: "UMP10000", email: "iqrasayyed135@gmail.com" }),
+      fpRes
+    );
+    assert.equal(fpRes.statusCode, 200);
+    assert.deepEqual(fpRes.body, {
+      result: {
+        success: true,
+        message: "A verification code has been sent to iq***5@gmail.com.",
+      },
+    });
+
+    const otpRes = makeRes();
+    await handler(
+      makeReq("verifyOTP", { studentId: "UMP10000", otp: "482910" }),
+      otpRes
+    );
+    assert.equal(otpRes.statusCode, 200);
+    assert.equal(otpRes.body.result.success, true);
+
+    const rpRes = makeRes();
+    await handler(
+      makeReq("resetPassword", { studentId: "UMP10000", password: "NewStrongPass#2027" }),
+      rpRes
+    );
+    assert.equal(rpRes.statusCode, 200);
+    assert.equal(rpRes.body.result.success, true);
+  });
+
+  assert.deepEqual(calls, [
+    {
+      url: "https://mentor.example.test/api/student-auth/forgot-password",
+      method: "POST",
+      body: { studentId: "UMP10000", email: "iqrasayyed135@gmail.com" },
+    },
+    {
+      url: "https://mentor.example.test/api/student-auth/verify-otp",
+      method: "POST",
+      body: { studentId: "UMP10000", otp: "482910" },
+    },
+    {
+      url: "https://mentor.example.test/api/student-auth/reset-password",
+      method: "POST",
+      body: { studentId: "UMP10000", password: "NewStrongPass#2027" },
+    },
+  ]);
+});
+
+test("recovery preserves backend success:false rejections without falling back to APPS_SCRIPT_URL", async () => {
+  await withFetch(async (url) => {
+    assert.equal(url, "https://mentor.example.test/api/student-auth/verify-otp");
+    return Response.json({
+      result: { success: false, message: "Incorrect verification code. 4 attempts left." },
+    });
+  }, async () => {
+    const res = makeRes();
+    await handler(makeReq("verifyOTP", { studentId: "UMP10000", otp: "000000" }), res);
+    assert.equal(res.statusCode, 200);
+    assert.deepEqual(res.body, {
+      result: { success: false, message: "Incorrect verification code. 4 attempts left." },
+    });
+  });
+});
+
+test("recovery upstream outage returns 502 and never falls back to APPS_SCRIPT_URL", async () => {
+  let calls = 0;
+  await withFetch(async (url) => {
+    calls += 1;
+    assert.equal(url, "https://mentor.example.test/api/student-auth/forgot-password");
+    return Response.json({ detail: "Account recovery is temporarily unavailable." }, { status: 502 });
+  }, async () => {
+    const res = makeRes();
+    await handler(
+      makeReq("forgotPassword", { studentId: "UMP10000", email: "iqrasayyed135@gmail.com" }),
+      res
+    );
+    assert.equal(res.statusCode, 502);
+    assert.equal(res.body.error, "Account recovery is temporarily unavailable.");
+    assert.equal(calls, 1);
+  });
+});
